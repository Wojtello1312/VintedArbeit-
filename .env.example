# Local shell template: cp .env.example .env; set -a; . ./.env; set +a
# Supply real values privately. Empty credentials keep job controls closed and Telegram unavailable.
TELEGRAM_BOT_TOKEN=
CHAT_ID=
JOBS_API_TOKEN=

# Offline defaults. Real Telegram delivery requires enabled=true and a production source/context.
VDH_NOTIFICATIONS='{"enabled":false,"daily_limit":50,"timeout_seconds":10,"max_attempts":3}'
VDH_SCHEDULER='{"enabled":true,"interval_seconds":300}'
# Optional native Playwright source. Install the browser extra first; keep false for demo.
VDH_VINTED='{"enabled":false}'

# Generate interactively: uv run --frozen python -m app.admin.password
# Put the generated hash in SINGLE quotes, preserving all dollar signs.
# No default password; empty ADMIN_PASSWORD_HASH disables admin access (HTTP 503).
ADMIN_PASSWORD_HASH=
VDH_ADMIN='{"username":"admin","secure_cookies":false,"session_seconds":28800}'
# Set secure_cookies=true when serving behind HTTPS. Local development uses HTTP.
